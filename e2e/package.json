{
  "name": "class-manager-e2e",
  "version": "1.0.0",
  "private": true,
  "license": "SEE LICENSE IN ../LICENSE.md",
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "db:migrate": "node scripts/migrateDatabase.mjs",
    "web:build": "node scripts/buildWeb.mjs",
    "test": "pnpm web:build && playwright test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:no-build": "playwright test",
    "screenshots": "pnpm web:build && playwright test --config playwright.screenshots.config.ts",
    "screenshots:no-build": "playwright test --config playwright.screenshots.config.ts",
    "screenshots:invitations": "playwright test --config playwright.screenshots.config.ts screenshots/Invitation_flows.capture.ts",
    "screenshots:emails": "playwright test --config playwright.emails.config.ts"
  },
  "devDependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/storage-blob": "12.34.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.20.5",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "typescript": "~7.0.2"
  }
}
