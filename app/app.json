{
  "expo": {
    "name": "Class Manager",
    "slug": "class-manager",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/images/icon.png",
    "scheme": "classmanager",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.alejandrolazarte.classmanager",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "web": {
      "output": "single",
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-font",
        {
          "android": {
            "fonts": [
              {
                "fontFamily": "material",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo/vector-icons/build/vendor/react-native-vector-icons/Fonts/MaterialIcons.ttf",
                    "weight": 400
                  }
                ]
              },
              {
                "fontFamily": "Nunito_600SemiBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/600SemiBold/Nunito_600SemiBold.ttf",
                    "weight": 600
                  }
                ]
              },
              {
                "fontFamily": "Nunito_700Bold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/700Bold/Nunito_700Bold.ttf",
                    "weight": 700
                  }
                ]
              },
              {
                "fontFamily": "Nunito_800ExtraBold",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf",
                    "weight": 800
                  }
                ]
              },
              {
                "fontFamily": "Nunito_900Black",
                "fontDefinitions": [
                  {
                    "path": "./node_modules/@expo-google-fonts/nunito/900Black/Nunito_900Black.ttf",
                    "weight": 900
                  }
                ]
              }
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "126cc23a-1b72-4baa-9590-639a326aa379"
      }
    },
    "owner": "alejandro-lazarte"
  }
}
