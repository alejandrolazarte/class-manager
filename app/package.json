    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "jest-expo": "~57.0.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
